{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyHrbpPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::REPLACE_WITH_BUCKET"],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["applicants/*", "hrd-documents/*", ".trash/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteHrbpObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BUCKET/applicants/*",
        "arn:aws:s3:::REPLACE_WITH_BUCKET/hrd-documents/*",
        "arn:aws:s3:::REPLACE_WITH_BUCKET/.trash/*"
      ]
    }
  ]
}
