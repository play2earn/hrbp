{
  "name": "novarecruit---modern-job-application-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:api": "esbuild api/*.ts --bundle --outdir=dist-api --platform=node --format=cjs",
    "build": "npm run build:api && vite build",
    "typecheck": "tsc --noEmit",
    "test:security": "esbuild server/security.ts server/file-access.ts server/storage.ts server/origin.ts server/orphan-cleanup.ts server/hr-access.ts server/api-router.ts --bundle --platform=node --format=cjs --out-extension:.js=.cjs --outdir=.tmp-test && node --test tests/security.test.cjs",
    "env:check": "node scripts/preflight.mjs --env .env.local --target staging",
    "env:check:production": "node scripts/preflight.mjs --env .env.local --target production",
    "audit:supabase-client": "node scripts/audit-direct-supabase.mjs",
    "audit:supabase-client:strict": "node scripts/audit-direct-supabase.mjs --strict --summary",
    "bundle:scan": "node scripts/scan-bundle-secrets.mjs --env .env.local --dir dist",
    "check:function-count": "node scripts/check-vercel-functions.mjs",
    "smoke:security": "node scripts/smoke-security.mjs",
    "check": "npm run check:function-count && npm run test:security && npm run typecheck && npm run build && npm run bundle:scan",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1050.0",
    "@supabase/supabase-js": "2.39.3",
    "browser-image-compression": "^2.0.2",
    "dotenv": "^17.2.3",
    "js-md5": "^0.8.3",
    "lucide-react": "^0.556.0",
    "pg": "^8.21.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-easy-crop": "^5.5.7",
    "recharts": "^3.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vercel/node": "^5.7.12",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
