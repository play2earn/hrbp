# Public browser configuration (publishable values only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_STORAGE_PROVIDER=r2+fallback

# Server-only authentication and database credentials
SUPABASE_URL=
# Recommended current Supabase backend key (legacy alternative: SUPABASE_SERVICE_ROLE_KEY)
SUPABASE_SECRET_KEY=
HRBP_SESSION_SECRET=
APP_ORIGIN=https://hrbp.company.com
IDMS_AGENT_CODE=
CRON_SECRET=

# AWS S3 primary attachment storage
ATTACHMENT_STORAGE_MODE=s3-primary
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_QUOTA_GB=1000

# Cloudflare R2 temporary draft/fallback storage
R2_DRAFT_ACCESS_MODE=private-proxy
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
